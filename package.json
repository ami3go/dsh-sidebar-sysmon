{
  "name": "@local/sidebar-sysmon",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Configurable CPU, memory, disk, and /tmp meter in the Harness Web sidebar foot",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/host.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
