{
  "name": "@local/sidebar-sysmon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live CPU and memory meter in the Harness Web sidebar foot",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  },
  "scripts": {
    "test": "node --test test/host.test.mjs"
  }
}
